{
  "name": "orbitant-os",
  "version": "1.0.0",
  "description": "Orbitant's Claude Code plugin marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "markdownlint-cli2 '**/*.md' '#node_modules' '#website'",
    "lint:fix": "markdownlint-cli2 --fix '**/*.md' '#node_modules' '#website'",
    "validate": "npm run validate:marketplace && npm run validate:plugins && npm run validate:skills && npm run validate:forks && npm run validate:versions",
    "validate:marketplace": "ajv validate -s .github/schemas/marketplace.schema.json -d .claude-plugin/marketplace.json",
    "validate:plugins": "node scripts/validate-plugins.cjs",
    "validate:skills": "node scripts/validate-skills.cjs",
    "validate:forks": "node scripts/validate-forks.cjs",
    "validate:versions": "node scripts/validate-versions.cjs",
    "test": "node --import tsx --test test/*.test.ts",
    "build:packages": "node --import tsx scripts/build-npm-packages.ts",
    "check": "npm run lint && npm run validate && npm run test && npm run build:packages",
    "check:upstream": "node scripts/check-upstream.cjs",
    "ci": "npm run check",
    "website:parse": "node --import tsx website/src/scripts/parse-plugins.ts && node --import tsx website/src/scripts/parse-blog.ts",
    "website:dev": "npm run website:parse && astro dev --root website",
    "website:build": "npm run website:parse && astro build --root website",
    "website:preview": "astro preview --root website"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.31.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-cli": "^5.0.0",
    "astro": "^5.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "markdownlint-cli2": "^0.21.0",
    "sharp": "^0.33.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/weorbitant/orbitant-os.git"
  },
  "license": "MIT"
}
