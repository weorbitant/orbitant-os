---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';

interface BlogPost {
  slug: string;
  title: string;
  description: string;
  date: string;
  author: string;
  tags: string[];
  content: string;
  plugin?: string;
  version?: string;
  isRelease: boolean;
}

let posts: BlogPost[] = [];

try {
  const blogModule = await import('../../content/generated/blog.json');
  posts = blogModule.default;
} catch {
  console.warn('No generated blog.json found.');
}

// Extract all unique tags from posts
const allTags = [...new Set(posts.flatMap((post) => post.tags))].sort();
---

<StarlightPage
  frontmatter={{
    title: 'Blog',
    description: 'News, updates, and release announcements from the Orbitant team',
    template: 'doc',
    tableOfContents: false,
  }}
>
  <p class="intro">News, updates, and release announcements from the Orbitant team.</p>

  {allTags.length > 0 && (
    <div class="tag-filter">
      <span class="filter-label">Filter by:</span>
      <button class="tag-pill active" data-tag="all">All</button>
      {allTags.map((tag) => (
        <button class="tag-pill" data-tag={tag}>{tag}</button>
      ))}
    </div>
  )}

  <div class="blog-list">
    {posts.length === 0 ? (
      <p class="no-posts">No posts yet. Check back soon!</p>
    ) : (
      posts.map((post) => (
        <div class="blog-item" data-tags={post.tags.join(',')}>
          <BlogPostCard
            slug={post.slug}
            title={post.title}
            description={post.description}
            date={post.date}
            author={post.author}
            tags={post.tags}
            isRelease={post.isRelease}
            plugin={post.plugin}
            version={post.version}
          />
        </div>
      ))
    )}
  </div>

  <p class="empty-state" style="display: none;">No posts match the selected filter.</p>
</StarlightPage>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tagPills = document.querySelectorAll('.tag-pill');
    const blogItems = document.querySelectorAll('.blog-item');
    const emptyState = document.querySelector('.empty-state');

    // Check URL for tag parameter
    const urlParams = new URLSearchParams(window.location.search);
    const initialTag = urlParams.get('tag') || 'all';

    function filterPosts(tag: string) {
      let visibleCount = 0;

      blogItems.forEach((item) => {
        const itemElement = item as HTMLElement;
        const itemTags = itemElement.dataset.tags?.split(',') || [];

        if (tag === 'all' || itemTags.includes(tag)) {
          itemElement.style.display = 'block';
          visibleCount++;
        } else {
          itemElement.style.display = 'none';
        }
      });

      // Update active state
      tagPills.forEach((pill) => {
        const pillElement = pill as HTMLElement;
        if (pillElement.dataset.tag === tag) {
          pillElement.classList.add('active');
        } else {
          pillElement.classList.remove('active');
        }
      });

      // Show/hide empty state
      if (emptyState) {
        (emptyState as HTMLElement).style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Update URL without reload
      const newUrl = new URL(window.location.href);
      if (tag === 'all') {
        newUrl.searchParams.delete('tag');
      } else {
        newUrl.searchParams.set('tag', tag);
      }
      window.history.replaceState({}, '', newUrl.toString());
    }

    // Set up click handlers
    tagPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = (pill as HTMLElement).dataset.tag || 'all';
        filterPosts(tag);
      });
    });

    // Apply initial filter
    filterPosts(initialTag);
  });
</script>

<style>
  .intro {
    font-size: 1.1rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 1.5rem;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: var(--sl-color-bg-inline-code);
    border-radius: 0.5rem;
  }

  .filter-label {
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin-right: 0.5rem;
  }

  .tag-pill {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.8rem;
    border-radius: 9999px;
    background: var(--sl-color-gray-2);
    color: var(--sl-color-gray-5);
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }

  .tag-pill.active {
    background: var(--sl-color-accent);
    color: var(--sl-color-bg);
    border-color: var(--sl-color-accent);
  }

  .blog-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .blog-item {
    transition: opacity 0.2s ease;
  }

  .no-posts {
    text-align: center;
    padding: 3rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }

  .empty-state {
    text-align: center;
    padding: 2rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
    background: var(--sl-color-bg-inline-code);
    border-radius: 0.5rem;
  }
</style>
