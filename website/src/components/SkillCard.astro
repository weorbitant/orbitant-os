---
import TagBadge from './TagBadge.astro';

interface Props {
  name: string;
  folder: string;
  description: string;
  version: string;
  tags: string[];
  plugin: string;
  href?: string;
}

const { name, folder, description, version, tags, plugin, href } = Astro.props;
---

<article class="skill-card">
  <header>
    <h3>
      {href ? (
        <a href={href}>{name}</a>
      ) : (
        name
      )}
    </h3>
    <span class="version">v{version}</span>
  </header>
  <p class="description">{description}</p>
  <div class="meta">
    <code class="invoke">/{ plugin }:{ folder }</code>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .skill-card header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.375rem;
  }

  .skill-card h3 {
    margin: 0;
    font-size: 1rem;
  }

  .skill-card h3 a {
    color: var(--sl-color-accent);
    text-decoration: none;
  }

  .skill-card h3 a:hover {
    text-decoration: underline;
  }

  .version {
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
  }

  .description {
    margin: 0 0 0.5rem 0;
    font-size: 0.875rem;
    color: var(--sl-color-gray-5);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .invoke {
    font-size: 0.75rem;
    padding: 0.125rem 0.375rem;
    background: var(--sl-color-gray-2);
    border-radius: 0.25rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
</style>
