---
import TagBadge from './TagBadge.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  date: string;
  author: string;
  tags: string[];
  isRelease?: boolean;
  plugin?: string;
  version?: string;
}

const { slug, title, description, date, author, tags, isRelease, plugin, version } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="blog-post-card" data-release={isRelease ? 'true' : undefined}>
  <header>
    <a href={`/orbitant-os/blog/${slug}/`}>
      <h3>{title}</h3>
    </a>
    {isRelease && version && (
      <span class="version">v{version}</span>
    )}
  </header>

  <div class="meta">
    <time datetime={date}>{formattedDate}</time>
    <span class="separator">·</span>
    <span class="author">{author}</span>
  </div>

  <p class="description">{description}</p>

  <footer>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <TagBadge tag={tag} />
        ))}
      </div>
    )}
    <a href={`/orbitant-os/blog/${slug}/`} class="read-more">Read more →</a>
  </footer>
</article>

<style>
  .blog-post-card {
    padding: 1.5rem;
    background: var(--sl-color-bg-inline-code);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    transition: border-color 0.2s ease;
  }

  .blog-post-card:hover {
    border-color: var(--sl-color-accent);
  }

  .blog-post-card[data-release] {
    border-left: 3px solid var(--sl-color-accent);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  h3 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  h3 a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--sl-color-accent);
  }

  .version {
    font-size: 0.75rem;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
    white-space: nowrap;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
  }

  .separator {
    color: var(--sl-color-gray-4);
  }

  .description {
    margin: 0 0 1rem 0;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .read-more {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-size: 0.875rem;
    margin-left: auto;
  }

  .read-more:hover {
    text-decoration: underline;
  }
</style>
